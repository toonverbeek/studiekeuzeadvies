# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example is the opt-in. It holds names and instructions, never a value, so
# it belongs in the repo. Its readers today are app/lib/mail.ts,
# app/site-config.ts and docs/decisions.md. Every other .env file stays out.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling
# Local settings, vendored skills, and the worktrees that agents make. A
# worktree is a full copy of the repo, so this line also keeps hundreds of
# megabytes out of the history.
/.claude

# The impeccable design skill keeps its measured palette and its hook cache
# here. Both are rebuilt from the repo, so a copy in the history would only go
# stale.
/.impeccable

# python
# scripts/build-url-map.py and docs/art/wordmark-paths.py both leave bytecode.
__pycache__/
*.pyc
