# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The example is the opt-in. It holds names and instructions, never a value, and
# app/components/maps.tsx and todos.md both send a reader to it, so it belongs
# in the repo. Every other .env file stays out.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent tooling
# Local settings, vendored skills, and the worktrees that agents make. A
# worktree is a full copy of the repo, so this line also keeps hundreds of
# megabytes out of the history.
/.claude

# python
# docs/art/build-marks.py imports docs/art/mark.py, so a run leaves bytecode.
__pycache__/
*.pyc
